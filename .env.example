# ============================================================
# agent_knowledge_self_built - 环境变量模板
# 复制为 .env 后填入你的真实密钥：
#   copy .env.example .env
# ============================================================

# --- LLM（OpenAI 兼容端点，默认指向 DeepSeek） ---
# DeepSeek: https://api.deepseek.com/v1
# OpenAI:   https://api.openai.com/v1
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# --- Embedding（OpenAI 兼容；留空则使用本地 hash 向量兜底） ---
# DeepSeek 暂不支持 embedding，可留空走 hash 兜底
# 或用 OpenAI: text-embedding-3-small / text-embedding-ada-002
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=30

# --- 向量库 / 数据库 ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base
SQLITE_PATH=./data/app.db

# --- 检索与切块 ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
CHUNK_SIZE=300
CHUNK_OVERLAP=60

# --- 工单兜底阈值（低于此值自动建单） ---
CONFIDENCE_THRESHOLD=0.5

# --- 意图分类灰度开关 ---
# 0(默认): 规则版意图分类，零 LLM 成本，可离线跑，回滚态
# 1: 启用 LLM 意图分类（输出 JSON 意图+置信度），失败自动回退规则版
USE_LLM_INTENT=0

# --- 日志 ---
LOG_LEVEL=INFO
